DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>?schema=pay_service"

CASHFREE_API_VERSION="2025-01-01"
CASHFREE_CLIENT_ID="<your-cashfree-client-id>"
CASHFREE_CLIENT_SECRET="<your-cashfree-client-secret>"
CASHFREE_ENV="PRODUCTION"
CASHFREE_NOTIFY_URL="https://pay.alterera.net/api/v1/webhooks/cashfree"
CASHFREE_TIMEOUT_MS="10000"
