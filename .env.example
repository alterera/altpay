# pay.alterera.net — payment service.
#
# This database is a SEPARATE instance from the hotel backend's. The hotel backend
# must never hold these credentials, and this service must never hold the hotel's.
#
# schema=pay_service is REQUIRED. Migrations and Prisma Client both target the
# pay_service schema (see prisma/schema.prisma). Without it, migrate may write to
# one schema while the runtime queries public and table-not-found errors follow.
DATABASE_URL="postgresql://payuser:<DB_PASSWORD>@pay-db-host:5432/postgres?schema=pay_service&sslmode=require"
# Optional override for the RDS CA bundle path (defaults to ./certs/global-bundle.pem)
# DATABASE_SSL_CA_PATH=./certs/global-bundle.pem

PORT=3002

# --- Cashfree ---------------------------------------------------------------
# See docs/cashfree-contract.md. SANDBOX or PRODUCTION.
CASHFREE_ENV=SANDBOX
# Overrides the base URL derived from CASHFREE_ENV.
# CASHFREE_BASE_URL=https://sandbox.cashfree.com/pg
CASHFREE_API_VERSION=2025-01-01
CASHFREE_CLIENT_ID=
# Also the webhook signing key. Never log this.
CASHFREE_CLIENT_SECRET=
# Checkout URL template; {payment_session_id} is substituted. Confirm against the
# merchant dashboard before going live.
# CASHFREE_CHECKOUT_URL_TEMPLATE=https://payments-test.cashfree.com/order/#{payment_session_id}
CASHFREE_WEBHOOK_MAX_SKEW_SECONDS=300
CASHFREE_TIMEOUT_MS=10000
# Public URL Cashfree posts webhooks to. Sent per order, so no dashboard-wide setting.
CASHFREE_NOTIFY_URL=https://pay.alterera.net/api/v1/webhooks/cashfree

# --- Hotel backend ----------------------------------------------------------
# Bearer token the hotel backend must present on inbound calls. Must match the
# hotel's PAYMENT_SERVICE_TOKEN.
HOTEL_SERVICE_TOKEN=
HOTEL_BASE_URL=https://api.alterstays.com
# HMAC secret for outbound notifications. Must match the hotel's
# PAYMENT_NOTIFICATION_SIGNING_SECRET exactly.
HOTEL_NOTIFICATION_SIGNING_SECRET=
HOTEL_TIMEOUT_MS=10000
HOTEL_NOTIFICATION_MAX_ATTEMPTS=6
# Delay in seconds before each retry, comma separated.
HOTEL_NOTIFICATION_BACKOFF_SECONDS=30,120,600,1800,7200,21600

# --- Reconciliation ---------------------------------------------------------
# How long a transaction may sit PENDING before reconciliation polls Cashfree.
RECONCILE_PENDING_AFTER_MINUTES=10
